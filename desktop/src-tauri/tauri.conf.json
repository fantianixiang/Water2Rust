{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Water2Rust",
  "version": "0.1.0",
  "identifier": "com.water2rust.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Water2Rust — 水体处理工具链",
        "width": 1080,
        "height": 720,
        "minWidth": 840,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
